# Environment configuration for the backend server
NODE_ENV=development

# Port for the backend server to run on
PORT=3001

# Allowed origins for CORS (comma separated if multiple)
CORS_ORIGINS=http://localhost:3000

# PostgreSQL database host (use 'db' for Docker setup)
POSTGRES_HOST=db
# PostgreSQL port (default is 5432)
POSTGRES_PORT=5432
# PostgreSQL database username
POSTGRES_USER=
# PostgreSQL database password
POSTGRES_PASSWORD=
# PostgreSQL database name
POSTGRES_DB=

# Superadmin password for initial setup
SUPERADMIN_PASSWORD=

# JWT secret key for signing tokens
JWT_SECRET=
# JWT token expiration time (e.g., 300m for 300 minutes)
JWT_EXPIRES_IN=
# Google OAuth2 Client ID (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
# Google OAuth2 Client Secret (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_SECRET=
# Google OAuth2 Callback URL (https://console.cloud.google.com/apis/credentials)
GOOGLE_CALLBACK_URL=

# Email Configuration
# Email provider to use: 'resend' (default) or 'mailhog' (for local development)
EMAIL_PROVIDER=resend
# Sender email address (used by all providers)
EMAIL_FROM="Workout App <noreply@workout-app.com>"
# Developer email for testing in development mode (overrides recipients)
EMAIL_DEV_TO=

# Resend-specific configuration (only needed when EMAIL_PROVIDER=resend)
# Resend API Key for email services (https://resend.com/api-keys)
RESEND_API_KEY=

# MailHog-specific configuration (only needed when EMAIL_PROVIDER=mailhog)
# MAILHOG_HOST=localhost  # Optional, defaults to localhost
# MAILHOG_PORT=1025       # Optional, defaults to 1025

# Path for image uploads
IMAGE_UPLOAD_PATH=./public/uploads/exercises

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379